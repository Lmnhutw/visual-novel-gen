{
  "name": "visual-novel-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node run-with-project-env.mjs next dev",
    "build": "node run-with-project-env.mjs next build",
    "start": "node run-with-project-env.mjs next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node run-with-project-env.mjs prisma migrate dev",
    "prisma:push": "node run-with-project-env.mjs prisma db push",
    "db:apply-initial": "node run-with-project-env.mjs tsx scripts/apply-initial-migration.ts",
    "db:mark-initial": "node run-with-project-env.mjs tsx scripts/mark-initial-migration-applied.ts",
    "prisma:studio": "node run-with-project-env.mjs prisma studio",
    "supabase:check": "node run-with-project-env.mjs tsx scripts/check-supabase-connection.ts",
    "db:migrate-characters": "node run-with-project-env.mjs tsx scripts/migrate-character-system.ts",
    "db:seed": "node run-with-project-env.mjs tsx scripts/seed-dev-data.ts",
    "generation:worker": "node run-with-project-env.mjs tsx scripts/run-generation-worker.ts",
    "test": "node run-with-project-env.mjs --database-only tsx --test tests/**/*.test.ts lib/**/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.19",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  }
}
