generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector", schema: "extensions")]
}

model Story {
  id          String   @id @default(cuid())
  ownerId     String?  @map("owner_id")
  primaryProtagonistId String? @unique @map("primary_protagonist_id")
  title       String
  description String?
  status      String   @default("ACTIVE")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  settings         StorySettings?
  characters       Character[]
  primaryProtagonist Character? @relation("StoryPrimaryProtagonist", fields: [primaryProtagonistId], references: [id], onDelete: SetNull)
  relationships    Relationship[]
  chapters         Chapter[]
  scenes           Scene[]
  events           Event[]
  loreEntries      LoreEntry[]
  secrets          Secret[]
  plotThreads      PlotThread[]
  memories         Memory[]
  embeddings       Embedding[]
  continuityIssues ContinuityIssue[]
  generationRuns   GenerationRun[]
  retrievalLogs    RetrievalLog[]
  generationJobs   GenerationJob[]
  draftVersions    DraftVersion[]
  canonProposals   CanonChangeProposal[]
  auditLogs        AuditLog[]

  @@index([ownerId])
  @@index([status, updatedAt])
  @@map("stories")
}

model StorySettings {
  id          String   @id @default(cuid())
  storyId     String   @unique @map("story_id")
  genre       String   @default("[]")
  tone        String?
  pov         String?
  tense       String?
  nsfwPolicy  String   @default("{}") @map("nsfw_policy")
  styleGuide  String?  @map("style_guide")
  modelConfig String   @default("{}") @map("model_config")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_settings")
}

model Character {
  id           String   @id @default(cuid())
  storyId      String   @map("story_id")
  sourceTemplateId String? @map("source_template_id")
  name         String
  aliases      String[] @default([])
  role         String   @default("SUPPORTING")
  status       String   @default("ACTIVE")
  ageConfirmed Boolean  @default(false) @map("age_confirmed")
  gender       String   @default("other")
  age          Int      @default(18)
  race         String?
  occupation   String?
  archetypes   String[] @default([])
  visibility   String   @default("canon")
  metadata     String   @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  story             Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  primaryForStory   Story?              @relation("StoryPrimaryProtagonist")
  profile           CharacterProfile?
  states            CharacterState[]
  povScenes         Scene[]             @relation("ScenePovCharacter")
  secretsHeld       Secret[]            @relation("SecretHolder")
  knowledgeTracking KnowledgeTracking[]
  relationshipsAsA  Relationship[]      @relation("RelationshipCharacterA")
  relationshipsAsB  Relationship[]      @relation("RelationshipCharacterB")
  memories          Memory[]

  @@unique([storyId, name])
  @@index([storyId])
  @@index([storyId, status])
  @@index([gender])
  @@index([age])
  @@map("characters")
}

model CharacterTemplate {
  id           String   @id @default(cuid())
  ownerId      String   @map("owner_id")
  name         String
  aliases      String[] @default([])
  ageConfirmed Boolean  @default(false) @map("age_confirmed")
  gender       String   @default("other")
  age          Int      @default(18)
  race         String?
  occupation   String?
  archetypes   String[] @default([])
  profile      Json     @default("{}")
  metadata     String   @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([ownerId, name])
  @@map("character_templates")
}

model CharacterProfile {
  id                     String   @id @default(cuid())
  characterId            String   @unique @map("character_id")
  personality            Json     @default("{}")
  voiceRules             String?  @map("voice_rules")
  backstory              String?
  appearance             Json?
  boundaries             Json?
  motivations            Json?
  talents                Json?
  speech                 Json?
  relationshipPreference Json?    @map("relationship_preference")
  background             Json?
  currentState           Json?    @map("current_state")
  characterArc           Json?    @map("character_arc")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_profiles")
}

model CharacterState {
  id             String   @id @default(cuid())
  characterId    String   @map("character_id")
  chapterId      String?  @map("chapter_id")
  sceneId        String?  @map("scene_id")
  location       String?
  emotionalState String   @default("{}") @map("emotional_state")
  physicalState  String   @default("{}") @map("physical_state")
  goals          String   @default("{}")
  validFrom      DateTime @default(now()) @map("valid_from")
  createdAt      DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  chapter   Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scene     Scene?    @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([characterId, validFrom])
  @@index([chapterId])
  @@index([sceneId])
  @@map("character_states")
}

model Relationship {
  id           String   @id @default(cuid())
  storyId      String   @map("story_id")
  characterAId String   @map("character_a_id")
  characterBId String   @map("character_b_id")
  type         String
  trust        Int      @default(0)
  intimacy     Int      @default(0)
  conflict     Int      @default(0)
  status       String   @default("NEUTRAL")
  boundaries   String   @default("{}")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  story      Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  characterA Character             @relation("RelationshipCharacterA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterB Character             @relation("RelationshipCharacterB", fields: [characterBId], references: [id], onDelete: Cascade)
  history    RelationshipHistory[]

  @@unique([storyId, characterAId, characterBId])
  @@index([storyId, status])
  @@index([characterAId])
  @@index([characterBId])
  @@map("relationships")
}

model RelationshipHistory {
  id              String   @id @default(cuid())
  relationshipId  String   @map("relationship_id")
  sceneId         String?  @map("scene_id")
  eventId         String?  @map("event_id")
  changeSummary   String   @map("change_summary")
  delta           String   @default("{}")
  emotionalWeight Float    @default(0) @map("emotional_weight")
  createdAt       DateTime @default(now()) @map("created_at")

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  scene        Scene?       @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([relationshipId, createdAt])
  @@index([sceneId])
  @@index([eventId])
  @@map("relationship_history")
}

model Chapter {
  id         String   @id @default(cuid())
  storyId    String   @map("story_id")
  number     Int
  title      String
  summary    String?
  content    String?
  status     String   @default("OUTLINE")
  tokenCount Int      @default(0) @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  story            Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scenes           Scene[]
  events           Event[]
  characterStates  CharacterState[]
  continuityIssues ContinuityIssue[]
  memories         Memory[]
  generationJobs   GenerationJob[]
  draftVersions    DraftVersion[]

  @@unique([storyId, number])
  @@index([storyId, status])
  @@map("chapters")
}

model Scene {
  id                 String    @id @default(cuid())
  storyId            String    @map("story_id")
  chapterId          String    @map("chapter_id")
  number             Int
  title              String?
  summary            String?
  content            String?
  povCharacterId     String?   @map("pov_character_id")
  location           String?
  startedAtStoryTime DateTime? @map("started_at_story_time")
  isFlashback        Boolean   @default(false) @map("is_flashback")
  tokenCount         Int       @default(0) @map("token_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  story               Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter             Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  povCharacter        Character?            @relation("ScenePovCharacter", fields: [povCharacterId], references: [id], onDelete: SetNull)
  events              Event[]
  characterStates     CharacterState[]
  relationshipHistory RelationshipHistory[]
  revealedSecrets     Secret[]              @relation("SecretRevealScene")
  knowledgeRecords    KnowledgeTracking[]   @relation("KnowledgeLearnedScene")
  continuityIssues    ContinuityIssue[]
  memories            Memory[]
  draftVersions       DraftVersion[]

  @@unique([chapterId, number])
  @@index([storyId, startedAtStoryTime])
  @@index([povCharacterId])
  @@map("scenes")
}

model Event {
  id           String    @id @default(cuid())
  storyId      String    @map("story_id")
  sceneId      String?   @map("scene_id")
  chapterId    String?   @map("chapter_id")
  eventTime    DateTime? @map("event_time")
  summary      String
  eventType    String    @map("event_type")
  participants String    @default("[]")
  salience     Float     @default(0.5)
  createdAt    DateTime  @default(now()) @map("created_at")

  story               Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scene               Scene?                @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  chapter             Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  impacts             EventImpact[]
  relationshipHistory RelationshipHistory[]

  @@index([storyId, eventTime])
  @@index([sceneId])
  @@index([chapterId])
  @@map("events")
}

model EventImpact {
  id         String   @id @default(cuid())
  eventId    String   @map("event_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  impactType String   @map("impact_type")
  before     String?
  after      String?
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([targetType, targetId])
  @@map("event_impacts")
}

model LoreEntry {
  id         String   @id @default(cuid())
  storyId    String   @map("story_id")
  category   String
  name       String
  content    String
  canonLevel Int      @default(1) @map("canon_level")
  tags       String   @default("[]")
  metadata   String   @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, category, name])
  @@index([storyId, category])
  @@map("lore_entries")
}

model Secret {
  id                String   @id @default(cuid())
  storyId           String   @map("story_id")
  name              String
  content           String
  truthStatus       String   @default("hidden") @map("truth_status")
  holderCharacterId String?  @map("holder_character_id")
  revealedAtSceneId String?  @map("revealed_at_scene_id")
  salience          Float    @default(0.7)
  metadata          String   @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  story             Story               @relation(fields: [storyId], references: [id], onDelete: Cascade)
  holderCharacter   Character?          @relation("SecretHolder", fields: [holderCharacterId], references: [id], onDelete: SetNull)
  revealedAtScene   Scene?              @relation("SecretRevealScene", fields: [revealedAtSceneId], references: [id], onDelete: SetNull)
  knowledgeTracking KnowledgeTracking[]

  @@index([storyId, truthStatus])
  @@index([holderCharacterId])
  @@index([revealedAtSceneId])
  @@map("secrets")
}

model PlotThread {
  id             String    @id @default(cuid())
  storyId        String    @map("story_id")
  title          String
  description    String?
  status         String    @default("OPEN")
  commitments    String    @default("[]")
  foreshadowing  String    @default("[]")
  resolutionNote String?   @map("resolution_note")
  salience       Float     @default(0.6)
  openedAt       DateTime  @default(now()) @map("opened_at")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, status, salience])
  @@map("plot_threads")
}

model KnowledgeTracking {
  id               String   @id @default(cuid())
  secretId         String   @map("secret_id")
  characterId      String   @map("character_id")
  knowledgeState   String   @map("knowledge_state")
  learnedAtSceneId String?  @map("learned_at_scene_id")
  evidence         String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  secret         Secret    @relation(fields: [secretId], references: [id], onDelete: Cascade)
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  learnedAtScene Scene?    @relation("KnowledgeLearnedScene", fields: [learnedAtSceneId], references: [id], onDelete: SetNull)

  @@unique([secretId, characterId])
  @@index([characterId])
  @@index([learnedAtSceneId])
  @@map("knowledge_tracking")
}

model Memory {
  id                  String                 @id @default(cuid())
  storyId             String                 @map("story_id")
  characterId         String?                @map("character_id")
  chapterId           String?                @map("chapter_id")
  sceneId             String?                @map("scene_id")
  sourceType          String                 @map("source_type")
  sourceId            String?                @map("source_id")
  memoryType          String                 @map("memory_type")
  content             String
  summary             String?
  salience            Float                  @default(0.5)
  emotionalWeight     Float                  @default(0) @map("emotional_weight")
  entities            String                 @default("{}")
  embedding           Unsupported("vector")?
  embeddingModel      String?                @map("embedding_model")
  embeddingDimensions Int?                   @map("embedding_dimensions")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  story     Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  chapter   Chapter?   @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scene     Scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([storyId, memoryType, salience])
  @@index([characterId])
  @@index([chapterId])
  @@index([sceneId])
  @@index([sourceType, sourceId])
  @@map("memories")
}

model Embedding {
  id         String                @id @default(cuid())
  storyId    String                @map("story_id")
  ownerType  String                @map("owner_type")
  ownerId    String                @map("owner_id")
  model      String
  dimensions Int
  chunkText  String                @map("chunk_text")
  embedding  Unsupported("vector")
  metadata   String                @default("{}")
  createdAt  DateTime              @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, ownerType])
  @@index([ownerType, ownerId])
  @@map("embeddings")
}

model ContinuityIssue {
  id              String   @id @default(cuid())
  storyId         String   @map("story_id")
  sceneId         String?  @map("scene_id")
  chapterId       String?  @map("chapter_id")
  generationRunId String?  @map("generation_run_id")
  severity        String
  category        String
  description     String
  evidence        String   @default("{}")
  confidence      Float    @default(0.5)
  status          String   @default("OPEN")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  story         Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scene         Scene?         @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  @@index([storyId, status, severity])
  @@index([sceneId])
  @@index([chapterId])
  @@index([generationRunId])
  @@map("continuity_issues")
}

model RetrievalLog {
  id              String   @id @default(cuid())
  storyId         String   @map("story_id")
  generationRunId String?  @map("generation_run_id")
  query           String
  filters         String   @default("{}")
  results         String   @default("[]")
  tokenBudget     Int      @default(0) @map("token_budget")
  createdAt       DateTime @default(now()) @map("created_at")

  story         Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)

  @@index([storyId, createdAt])
  @@index([generationRunId])
  @@map("retrieval_logs")
}

model GenerationRun {
  id               String   @id @default(cuid())
  storyId          String   @map("story_id")
  type             String
  status           String   @default("QUEUED")
  input            String   @default("{}")
  prompt           String?
  output           String?
  model            String
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  story            Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  retrievalLogs    RetrievalLog[]
  continuityIssues ContinuityIssue[]
  generationJob    GenerationJob?
  draftVersions    DraftVersion[]

  @@index([storyId, createdAt])
  @@index([status])
  @@map("generation_runs")
}

model GenerationJob {
  id               String   @id @default(cuid())
  storyId          String   @map("story_id")
  chapterId        String?  @map("chapter_id")
  generationRunId  String?  @unique @map("generation_run_id")
  draftVersionId   String?  @unique @map("draft_version_id")
  type             String
  status           String   @default("QUEUED")
  stage            String   @default("QUEUED")
  progress         Int      @default(0)
  idempotencyKey   String?  @map("idempotency_key")
  input            String   @default("{}")
  contextSnapshot  String?  @map("context_snapshot")
  prompt           String?
  errorCode        String?  @map("error_code")
  error            String?
  fallbackModel    String?  @map("fallback_model")
  fallbackExpiresAt DateTime? @map("fallback_expires_at")
  attemptCount     Int      @default(0) @map("attempt_count")
  createdAt        DateTime @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  story          Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter        Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  generationRun  GenerationRun?        @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  draftVersion   DraftVersion?         @relation("GenerationJobDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
  proposals      CanonChangeProposal[]

  @@unique([storyId, idempotencyKey])
  @@index([status, createdAt])
  @@index([storyId, createdAt])
  @@map("generation_jobs")
}

model DraftVersion {
  id              String   @id @default(cuid())
  storyId         String   @map("story_id")
  chapterId       String?  @map("chapter_id")
  sceneId         String?  @map("scene_id")
  generationRunId String?  @map("generation_run_id")
  versionNumber   Int      @map("version_number")
  status          String   @default("DRAFT")
  title           String?
  content         String
  metadata        String   @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  story         Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scene         Scene?         @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  generationRun GenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: SetNull)
  job           GenerationJob? @relation("GenerationJobDraftVersion")

  @@index([storyId, createdAt])
  @@index([chapterId, versionNumber])
  @@index([generationRunId])
  @@map("draft_versions")
}

model CanonChangeProposal {
  id               String   @id @default(cuid())
  storyId          String   @map("story_id")
  generationJobId  String   @map("generation_job_id")
  type             String
  targetType       String   @map("target_type")
  targetId         String?  @map("target_id")
  title            String
  description      String?
  before           String?  @map("before")
  proposedAfter    String   @map("proposed_after")
  confidence       Float    @default(0.5)
  actionability    String   @default("MANUAL_REVIEW")
  status           String   @default("PENDING")
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  story Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  job   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([storyId, status, createdAt])
  @@index([generationJobId])
  @@map("canon_change_proposals")
}

model AuditLog {
  id        String   @id @default(cuid())
  storyId   String?  @map("story_id")
  actorId   String?  @map("actor_id")
  action    String
  entityType String  @map("entity_type")
  entityId  String?  @map("entity_id")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([storyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
