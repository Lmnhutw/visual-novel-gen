# Copy to env/.env for Docker Compose.
# Copy to .env.local at the repository root for npm run dev/build.

# Required database connections.
# Use a pooled URL for the app and a direct URL for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Required for AI generation.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing. Empty evaluation/extraction values fall back to GENERATION_MODEL.
GENERATION_MODEL=qwen/qwen-2.5-72b-instruct
FREE_GENERATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PAID_FALLBACK_MODEL=qwen/qwen-2.5-72b-instruct
EVALUATION_MODEL=
EXTRACTION_MODEL=

# Background worker interval in milliseconds. Minimum: 1000.
GENERATION_WORKER_POLL_MS=5000

# Optional features.
ENABLE_EMBEDDINGS=false
REQUIRE_AUTH=false

# Required when REQUIRE_AUTH=true or when using Supabase clients directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
